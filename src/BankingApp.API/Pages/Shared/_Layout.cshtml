<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BudgetFlow</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="topnav d-none" id="topnav">
        <a class="nav-brand" href="/Dashboard">
            <div class="brand-gem"><i class="bi bi-wallet2"></i></div>
            BudgetFlow
        </a>
        <div class="nav-links">
            <a href="/Dashboard" class="nav-link" data-page="Dashboard"><i class="ti ti-layout-dashboard"></i><span>Dashboard</span></a>
            <a href="/Transactions" class="nav-link" data-page="Transactions"><i class="ti ti-arrows-left-right"></i><span>Tranzacții</span></a>
            <a href="/Bills" class="nav-link" data-page="Bills"><i class="ti ti-receipt"></i><span>Facturi</span></a>
            <a href="/Recurring" class="nav-link" data-page="Recurring"><i class="ti ti-refresh"></i><span>Recurente</span></a>
            <a href="/Reports" class="nav-link" data-page="Reports"><i class="ti ti-chart-bar"></i><span>Rapoarte</span></a>
        </div>
        <div class="nav-right">
            <div class="nav-avatar" id="navAvatar">MI</div>
            <span class="nav-user-name" id="navUserName"></span>
            <button class="nav-logout" onclick="logout()" title="Deconectare"><i class="bi bi-box-arrow-right"></i></button>
        </div>
    </nav>

    <div id="pageBody">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
